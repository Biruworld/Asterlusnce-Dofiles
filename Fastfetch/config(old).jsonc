{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/images/arch.txt",
    "color": {
      "1": "#C4A7E7"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#C4A7E7"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "Asterlusnce-Arch"
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "Asterlusnce-PC"
    },
    {
      "type": "shell",
      "format": "Sakura begins and ends beautifully.",
      "key": ">_",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      //"format": "Intel Core i3-1215U @3.30GHz"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      //"format": "Intel iGPU UHD Gen 12 @1.10GHz"
    },
     {
      "type": "memory",
      "key": "🐏 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "{} / {}"
    },

     {
      "type": "swap",
      "key": "🐏",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "{} / {} (swap)"
    },

    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },

    {
      "type": "cursor",
      "key": "➤ ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },

     {
      "type": "battery",
      "key": "🔋 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },


    
    "break",
    "break",
    "break"
  ]
}
